<Window x:Class="MyVerse.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyVerse.Ui"
        Title="Siloé Stream" Icon="/myverse.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Page}" Foreground="{StaticResource Blanc}"
        FontFamily="{StaticResource Ui}" FontSize="15"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
    <!-- Siloé Stream 1.5.0, design « Télécommande » : trois pages à gauche (Culte, Bibliothèque, Son) ; en haut, le culte, la recherche
         partout (Ctrl K) et l'état (projecteur, téléphone, écran de scène, heure) ; au centre, l'écran en direct en grand ;
         à droite, ce qui vient (Ensuite) et les outils de l'écran repliés (style, taille, coin, écran de repos) ;
         en bas, la télécommande : ce qui est à l'écran, Précédent, le gros Suivant, Noir, Effacer. -->
    <Window.Resources>
        <Style x:Key="LigneVerset" TargetType="Border">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Nuit2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CarteSection" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Encre}" />
            <Setter Property="BorderBrush" Value="{StaticResource Nuit3}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,10,14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Trait2}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ModeleChant">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnAjout}" Click="AjouterChantListe_Click" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock x:Name="Recueil" Text="{Binding Author}" FontSize="12" Foreground="{StaticResource Brume2}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Author}" Value="">
                    <Setter TargetName="Recueil" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- une ligne du programme (1.5.0) : l'heure, l'icône du type, le titre et le détail ; « En direct » en rouge sur ce qui est à l'écran,
             « Par défaut » sur l'écran de repos choisi ; cadre bordeaux quand elle est choisie, pâlie quand elle est passée -->
        <DataTemplate x:Key="ModeleAgenda">
            <Border x:Name="Cadre" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="13">
                <Grid>
                    <Border x:Name="Barre" Width="4" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2" Background="{StaticResource Ecran}" Visibility="Collapsed" />
                    <Grid Margin="8,9,8,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Heure}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{Binding FondType}" VerticalAlignment="Center">
                            <Path Data="{Binding Icone}" Stroke="{Binding Couleur}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Titre}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                            <TextBlock Text="{Binding Detail}" FontSize="12.5" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border x:Name="EnCours" Background="{StaticResource Ecran}" CornerRadius="4" Padding="8,2,9,3" HorizontalAlignment="Right" Visibility="Collapsed">
                                <TextBlock Text="À L'ÉCRAN" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource SurEcran}" />
                            </Border>
                            <Border x:Name="Defaut" Background="{StaticResource OrLeger}" BorderBrush="{StaticResource OrBord}" BorderThickness="1" CornerRadius="10" Padding="8,1,8,2" Margin="0,4,0,0"
                                    HorizontalAlignment="Right" Visibility="Collapsed" ToolTip="Écran de repos : Effacer revient dessus">
                                <TextBlock Text="Par défaut" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource Or}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Fait}" Value="True">
                    <Setter TargetName="Cadre" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Defaut}" Value="True">
                    <Setter TargetName="Defaut" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Cadre" Property="Opacity" Value="1" />
                    <Setter TargetName="Cadre" Property="Background" Value="{StaticResource OrLeger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Nuit2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding EnCours}" Value="True">
                    <Setter TargetName="EnCours" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Barre" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Cadre" Property="Opacity" Value="1" />
                    <Setter TargetName="Cadre" Property="Background" Value="{StaticResource RougeLeger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource OrVif}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- une source de la bibliothèque Display : titre, description, et « + » (✓ quand elle est dans la grille) -->
        <DataTemplate x:Key="ModeleAnnonce">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Titre}" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Blanc}" />
                    <TextBlock Text="{Binding Description}" FontSize="12" MaxHeight="18" Foreground="{StaticResource Brume2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="Grille" Grid.Column="1" Style="{StaticResource BtnGrille}" Click="GrilleAnnonceListe_Click" VerticalAlignment="Center" ToolTip="Ajouter à la grille (un clic dans la grille = en direct)">
                    <Path x:Name="Signe" Data="{StaticResource IconePlus}" Stroke="{StaticResource Or}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Grille}" Value="True">
                    <Setter TargetName="Signe" Property="Data" Value="{StaticResource IconeCoche}" />
                    <Setter TargetName="Signe" Property="Width" Value="15" />
                    <Setter TargetName="Grille" Property="Background" Value="{StaticResource OrLeger}" />
                    <Setter TargetName="Grille" Property="BorderBrush" Value="{StaticResource OrVif}" />
                    <Setter TargetName="Grille" Property="ToolTip" Value="Dans la grille · cliquer pour l'en retirer" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColonneRail" Width="84" />
            <ColumnDefinition x:Name="ColonneGauche" Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ColonneDroite" Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <!-- ==================== barre des pages : Culte, Bibliothèque, Son ==================== -->
        <Border Grid.RowSpan="3" Background="{StaticResource Rail}" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,10,0,12">
                <StackPanel DockPanel.Dock="Top">
                    <Border x:Name="LogoCompact" Width="46" Height="46" HorizontalAlignment="Center" ToolTip="Siloé Stream">
                        <Image Source="/logo-icone.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Button x:Name="VersionBtn" Style="{StaticResource BtnPlat}" Padding="6,2" Margin="0,5,0,16" FontSize="10.5" Foreground="{StaticResource Brume2}" HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center" ToolTip="Vérifier les mises à jour" Content="v3" />
                    <RadioButton x:Name="OngletAgenda" Style="{StaticResource OngletRail}" GroupName="Pages" Content="Culte" Tag="{StaticResource IconeCulte}"
                                 ToolTip="Le programme du culte et ce qui est à l'écran (Ctrl K pour chercher)" />
                    <RadioButton x:Name="OngletBiblio" Style="{StaticResource OngletRail}" GroupName="Biblio" Content="Bibliothèque" Tag="{StaticResource IconeBible}"
                                 ToolTip="La Bible, les chants, les médias (images, vidéos, Zoom, caméras) et les duos" />
                    <!-- 1.8.0 : les médias (caméras, images, vidéos, fenêtres) ont leur bouton -->
                    <RadioButton x:Name="OngletMediasRail" Style="{StaticResource OngletRail}" GroupName="Medias" Content="Médias" Tag="{StaticResource IconeDisplay}"
                                 ToolTip="Les médias : caméras, MyCam, images, vidéos, fenêtres (Zoom…)" />
                    <RadioButton x:Name="OngletSon" Style="{StaticResource OngletRail}" GroupName="Pages" Content="Son" Tag="{StaticResource IconeSon}"
                                 ToolTip="Les micros, la musique, l'enregistrement du culte et Zoom" />
                    <!-- 2.2.0 : le montage des enregistrements et la publication sur YouTube -->
                    <RadioButton x:Name="OngletMontage" Style="{StaticResource OngletRail}" GroupName="Pages" Content="Montage" Tag="{StaticResource IconeMontage}"
                                 ToolTip="Monter l'enregistrement du culte (couper, titres, logo, fondus) et le publier sur YouTube sans exporter" />
                    <!-- 2.3.0 : les miniatures YouTube -->
                    <RadioButton x:Name="OngletMiniature" Style="{StaticResource OngletRail}" GroupName="Pages" Content="Miniature" Tag="{StaticResource IconeMiniature}"
                                 ToolTip="Créer la miniature YouTube : une image de la vidéo (envoyée depuis Montage), des modèles, du texte à gros contour" />
                    <!-- 1.5.0 : les pages de la Bibliothèque se choisissent avec ses onglets (en haut de la colonne) -->
                    <RadioButton x:Name="OngletBible" GroupName="Pages" Visibility="Collapsed" IsChecked="True" />
                    <RadioButton x:Name="OngletChants" GroupName="Pages" Visibility="Collapsed" />
                    <RadioButton x:Name="OngletAnnonces" GroupName="Pages" Visibility="Collapsed" />
                    <RadioButton x:Name="OngletDuo" GroupName="Pages" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button x:Name="ThemeBtn" Style="{StaticResource BtnRail}" Content="Sombre" Tag="{StaticResource IconeLune}" ToolTip="Passer en mode sombre (aussi dans Réglages › Apparence)" />
                    <RadioButton x:Name="OngletReglages" Style="{StaticResource OngletRail}" GroupName="Pages" Content="Réglages" Tag="{StaticResource IconeReglages}" Margin="0"
                                 ToolTip="Apparence, son, projection, téléphone, mise à jour, journal, licences" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <!-- ==================== en haut : le culte, la recherche (partout), l'état et l'heure ==================== -->
        <Border Grid.Column="1" Grid.ColumnSpan="3" Background="{StaticResource Page}" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="AgendaMenu" Style="{StaticResource BtnPlat}" Padding="10,7" VerticalAlignment="Center" HorizontalAlignment="Left"
                        ToolTip="Changer de culte, nouveau, renommer, partager sur WhatsApp, supprimer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AgendaTitre" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource Blanc}" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center" />
                        <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Brume}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="10,2,0,0" />
                    </StackPanel>
                </Button>
                <local:Capitales x:Name="AgendaSurtitre" Visibility="Collapsed" />

                <!-- recherche du culte (Ctrl K) : versets, chants (« wokovu 45 »), paroles et versets mal écrits, médias -->
                <Grid Grid.Column="1" MaxWidth="560" Margin="18,0" VerticalAlignment="Center">
                    <Border x:Name="RechercheCulte" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="6" Padding="16,0,8,0" Height="44"
                            ToolTip="Ctrl K : chercher un verset, un chant ou des paroles">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                            <TextBlock x:Name="CmdIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                       Text="Que veux-tu montrer ? jean 3 16, wokovu 45, des paroles…" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="Cmd" Grid.Column="1" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                     CaretBrush="{StaticResource Blanc}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,10" FocusVisualStyle="{x:Null}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 2.2.0 : la recherche vocale : « Chant ou Bible ? », puis Siloé Stream écoute et trouve -->
                                <Button x:Name="CmdMicro" Style="{StaticResource BtnPlat}" Padding="6,2" Margin="0,0,2,0" VerticalAlignment="Center"
                                        ToolTip="Recherche vocale : écouter un chant ou la prédication, et trouver le chant ou le verset">
                                    <Path Data="M12,3 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 V6 A3,3 0 0 1 12,3 Z M5.5,10.5 A6.5,6.5 0 0 0 18.5,10.5 M12,17 V21 M8.5,21 H15.5"
                                          Stroke="{StaticResource Or}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" />
                                </Button>
                                <Button x:Name="CmdEffacer" Style="{StaticResource BtnPlat}" Padding="8,2" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Annuler la recherche" />
                                <Border Style="{StaticResource Touche}" Margin="6,0,6,0">
                                    <TextBlock Text="Ctrl K" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brume}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Popup x:Name="CmdPopup" PlacementTarget="{Binding ElementName=RechercheCulte}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False"
                           Width="{Binding ActualWidth, ElementName=RechercheCulte}">
                        <Border Background="{StaticResource Encre}" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,8,0,14">
                            <StackPanel>
                                <StackPanel x:Name="CmdResultats" />
                                <TextBlock x:Name="CmdAide" Margin="10,6,10,4" FontSize="12" Foreground="{StaticResource Brume}" Text="Entrée ou clic : y aller. Maj+Entrée : montrer tout de suite. Tab ou + : ajouter au programme. ↑ ↓ : choisir. × : annuler." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MajBtn" Style="{StaticResource BtnPetitOr}" Margin="0,0,10,0" Visibility="Collapsed" Content="Mettre à jour" />
                    <!-- 2.1.0 : Commencer le culte : tout est vérifié (projecteur, YouTube, son, caméras), puis l'enregistrement démarre -->
                    <Button x:Name="CommencerBtn" Style="{StaticResource Btn}" Height="40" Padding="14,0" Margin="0,0,10,0" FontWeight="Bold" FontSize="14"
                            Background="{StaticResource Vert}" BorderBrush="{StaticResource Vert}"
                            ToolTip="Vérifie le projecteur, YouTube, le son et les caméras, puis lance l'enregistrement du culte dans le dossier choisi (Réglages › Son)">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="CommencerIcone" Data="M0,0 L9,6 L0,12 Z" Fill="{StaticResource SurVert}" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock x:Name="CommencerTexte" Text="Commencer le culte" Foreground="{StaticResource SurVert}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProjectionBtn" Style="{StaticResource PuceEtat}" ToolTip="Choisir l'écran de projection">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ProjectionPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock x:Name="ProjectionTexte" Text="Projection arrêtée" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TelBtn" Style="{StaticResource PuceEtat}" Margin="8,0,0,0" ToolTip="Télécommande Android et MyCam">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TelPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,8,0" Visibility="Collapsed" />
                            <TextBlock x:Name="TelTexte" Text="Téléphone" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DirectBtn" Style="{StaticResource PuceEtat}" Margin="8,0,0,0" ToolTip="Le direct sur YouTube : MyStream et le son partent sur Internet">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DirectPoint" Width="8" Height="8" Fill="{StaticResource Brume2}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock x:Name="DirectTexte" Text="YouTube" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="SceneSep" Text="" Width="0" />
                    <Button x:Name="SceneBtn" Style="{StaticResource PuceEtat}" Margin="8,0,0,0" Content="Écran de scène"
                            ToolTip="Écran de scène : l'heure, ce qui est à l'écran et ce qui vient (pour le prédicateur et la chorale)" />
                    <TextBlock x:Name="Horloge" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Blanc}" VerticalAlignment="Center" Margin="16,0,0,0" Text="00:00:00"
                               Typography.NumeralAlignment="Tabular" ToolTip="Heure de l'ordinateur" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== colonne de gauche : le programme, ou la Bibliothèque et ses onglets ==================== -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border x:Name="BiblioOnglets" DockPanel.Dock="Top" Margin="14,16,14,2" Background="{StaticResource Nuit2}" CornerRadius="10" Padding="3" Visibility="Collapsed">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="SegBible" Style="{StaticResource Segment}" GroupName="Segments" Content="Bible" ToolTip="Les Bibles, les livres, les versets" />
                        <RadioButton x:Name="SegChants" Style="{StaticResource Segment}" GroupName="Segments" Content="Chants" ToolTip="Les recueils et les chants" />
                        <RadioButton x:Name="SegMedias" Style="{StaticResource Segment}" GroupName="Segments" Content="Médias" ToolTip="Textes, images, vidéos, Zoom, caméras, MyCam" />
                        <RadioButton x:Name="SegDuo" Style="{StaticResource Segment}" GroupName="Segments" Content="Duo" ToolTip="Deux contenus ensemble (un dossier = 2 éléments)" />
                    </UniformGrid>
                </Border>
                <Grid>
            <!-- Culte : le programme -->
            <Border x:Name="PanneauAgenda" Visibility="Collapsed" Padding="12,18,12,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,0,8,12">
                        <TextBlock Text="Programme" FontSize="23" FontWeight="ExtraBold" Foreground="{StaticResource Blanc}" />
                        <TextBlock x:Name="AgendaInfo" FontSize="12.5" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="2,10,2,0">
                        <Rectangle RadiusX="13" RadiusY="13" Stroke="{StaticResource Trait2}" StrokeDashArray="4 3" StrokeThickness="1.2" IsHitTestVisible="False" />
                        <Button x:Name="AgendaAjouter" Style="{StaticResource Btn}" Background="Transparent" BorderBrush="Transparent" Content="+ Ajouter au programme" FontWeight="Bold"
                                Foreground="{StaticResource Blanc}" Height="48" Padding="0" ToolTip="Ajouter un chant, un passage, un média, un compte à rebours" />
                    </Grid>
                    <Grid>
                        <ListBox x:Name="ListeAgenda" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementDeroule}" ItemTemplate="{StaticResource ModeleAgenda}" />
                        <TextBlock x:Name="AgendaVide" Margin="8,4,8,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="13.5" Foreground="{StaticResource Brume}" IsHitTestVisible="False" LineHeight="21"
                                   Text="Le programme est vide. « + Ajouter au programme » ou cherche en haut (Ctrl K) : « wokovu 45 », « jean 3 16 »… puis Tab. Les boutons + de la Bibliothèque ajoutent aussi ici." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Bible : les Bibles et les livres -->
            <Border x:Name="PanneauBible">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,14,14,18">
                    <StackPanel>
                        <local:Capitales Libelle="Bibles" />
                        <StackPanel x:Name="BiblesChoix" Margin="0,10,0,0" />
                        <Grid Margin="0,2,0,0">
                            <Rectangle RadiusX="10" RadiusY="10" Stroke="{StaticResource Brume2}" StrokeDashArray="4 3" StrokeThickness="1" IsHitTestVisible="False" />
                            <Button x:Name="BiblesImporter" Style="{StaticResource Btn}" Background="Transparent" BorderBrush="Transparent" Padding="10" FontWeight="Bold" Foreground="{StaticResource Encre2}" Content="+ Importer une Bible" />
                        </Grid>
                        <TextBlock x:Name="BiblesEtat" Style="{StaticResource MuetPetit}" Margin="0,8,0,0">
                            <Run Text="Cliquez une Bible pour l'afficher ·" /> <Run Text="2e" FontWeight="Bold" /> <Run Text="= versets bilingues (sous le verset)" />
                        </TextBlock>
                        <Button x:Name="BiblesGerer" Style="{StaticResource BtnLien}" Content="Gérer les Bibles…" Margin="0,8,0,0" ToolTip="Supprimer une Bible, choisir dans une liste" />
                        <local:Capitales Libelle="Ancien Testament" Margin="0,20,0,8" />
                        <UniformGrid x:Name="LivresAT" Columns="4" />
                        <local:Capitales Libelle="Nouveau Testament" Margin="0,14,0,8" />
                        <UniformGrid x:Name="LivresNT" Columns="4" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Chants : le recueil, l'import et la liste -->
            <Border x:Name="PanneauChants" Visibility="Collapsed" Padding="14,14,14,14">
                <DockPanel>
                    <local:Capitales DockPanel.Dock="Top" Libelle="Recueil" Margin="0,0,0,8" />
                    <DockPanel DockPanel.Dock="Top">
                        <Button x:Name="SupprimerRecueil" DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Supprimer" FontSize="12" Padding="7,5" Margin="6,0,0,0" ToolTip="Supprimer ce recueil et ses chants" />
                        <ComboBox x:Name="Recueil" ToolTip="Recueil" MaxDropDownHeight="520" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                        <Button x:Name="Importer" Style="{StaticResource BtnOr}" Content="+ Importer des chants" Height="44" Padding="0"
                                ToolTip="Ajouter des chants ou un recueil : VideoPsalm, OpenLyrics, OpenSong, ChordPro, SongSelect, ProPresenter 6, PDF, texte collé, lien d'un site" />
                        <Button x:Name="Nouveau" Style="{StaticResource Btn}" Content="+ Nouveau chant" Height="44" Padding="0" Margin="0,8,0,0"
                                ToolTip="Taper ou coller un chant : il est rangé tout seul en diapositives" />
                    </StackPanel>
                    <Border x:Name="NumBoite" DockPanel.Dock="Top" Margin="0,0,0,8" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10" Padding="12,0,4,0"
                            ToolTip="Taper le numéro du chant dans ce recueil (Entrée : ouvrir, puis 1-9 pour les strophes)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="N°" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Or}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NumIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                       Text="Numéro du chant" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="NumChant" Grid.Column="1" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}" MaxLength="6"
                                     CaretBrush="{StaticResource Blanc}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,9" FocusVisualStyle="{x:Null}" InputMethod.IsInputMethodEnabled="False" />
                            <Button x:Name="NumEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,2" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer le numéro" />
                        </Grid>
                    </Border>
                    <Grid>
                        <ListBox x:Name="ListeChants" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementChant}" ItemTemplate="{StaticResource ModeleChant}" />
                        <TextBlock x:Name="ListeVide" Margin="6,14,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Display : la bibliothèque -->
            <Border x:Name="PanneauAnnonces" Visibility="Collapsed" Padding="14,14,14,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <local:Capitales Libelle="Médias" />
                        <Button x:Name="DisplayAjouter" Style="{StaticResource BtnOr}" Content="+ Ajouter un média" Height="44" Padding="14,0" Margin="0,10,0,0" ToolTip="Ajouter un texte, des images, une vidéo, une fenêtre ou un Duo" />
                        <!-- 2.1.0 : les caméras à part des médias : MyVirtualCam, webcams, cartes de capture, téléphone MyCam, caméra Sony -->
                        <Button x:Name="DisplayPeripherique" Style="{StaticResource Btn}" Content="+ Ajouter un périphérique vidéo" Height="44" Padding="14,0" Margin="0,8,0,0"
                                ToolTip="Une caméra : MyVirtualCam (l'image de MyStream), une webcam, une carte de capture USB/HDMI, un téléphone MyCam ou une caméra Sony par Wi-Fi" />
                        <TextBlock Text="Le + met un média dans la grille (✓ : il y est déjà). Double-clic : le montrer. Clic droit : modifier, garder dans un coin, supprimer."
                                   TextWrapping="Wrap" Foreground="{StaticResource Brume}" FontSize="12.5" LineHeight="18" Margin="0,10,0,0" />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <ListBox x:Name="ListeAnnonces" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementCarte}" ItemTemplate="{StaticResource ModeleAnnonce}" />
                        <TextBlock x:Name="AnnoncesVide" Margin="6,8,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" IsHitTestVisible="False" LineHeight="22"
                                   Text="Ajoutez un texte, une image, un périphérique vidéo ou une capture de fenêtre." />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Duo : les dossiers -->
            <Border x:Name="PanneauDuo" Visibility="Collapsed" Padding="14,14,14,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <local:Capitales Libelle="Dossiers" />
                        <Button x:Name="DuoNouveau" Style="{StaticResource BtnOr}" Content="+ Nouveau duo" Height="44" Padding="0" Margin="0,10,0,0" />
                        <TextBlock Margin="2,10,2,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Brume}" Text="Un dossier = 2 éléments affichés ensemble. Double-clic : en direct." />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <ListBox x:Name="ListeDuos" Style="{StaticResource ListeChants}" ItemContainerStyle="{StaticResource ElementCarte}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1,0,1">
                                        <TextBlock Text="{Binding Nom}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Brume2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="DuosVide" Margin="6,8,6,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource Brume}" IsHitTestVisible="False" LineHeight="22"
                                   Text="Aucun dossier. Cliquez « + Nouveau duo »." />
                    </Grid>
                </DockPanel>
            </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ==================== centre : l'écran en direct en grand (Culte), ou la page de la Bibliothèque ==================== -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <Grid x:Name="EnTete" DockPanel.Dock="Top" Margin="24,18,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top">
                    <local:Capitales x:Name="Surtitre" Libelle="Toutes les diapositives du culte" Margin="0" TextTrimming="CharacterEllipsis" />
                    <!-- Culte : l'élément choisi dans le déroulé -->
                    <TextBlock x:Name="ElemTitre" Style="{StaticResource GrandTitre}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Text="Préparez le culte" />
                    <!-- Bible : le chapitre -->
                    <StackPanel x:Name="TeteBible" Margin="0,3,0,0">
                        <!-- chacun prend la place qui reste : le titre se coupe (…) avant de pousser « › » hors de vue -->
                        <DockPanel LastChildFill="False">
                            <Button x:Name="ChapPrec" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="‹" ToolTip="Chapitre précédent" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TitreChap" DockPanel.Dock="Left" Style="{StaticResource GrandTitre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button x:Name="ChapSuiv" DockPanel.Dock="Left" Style="{StaticResource BtnPetit}" Content="›" ToolTip="Chapitre suivant" Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AgendaAjoutBible" Style="{StaticResource BtnPetit}" Content="+ Programme" ToolTip="Ajouter les versets choisis (ou le chapitre) au programme du culte" VerticalAlignment="Center" />
                            <TextBlock x:Name="VersionsLab" Style="{StaticResource Muet}" VerticalAlignment="Center" Text="Version : LSG" Margin="12,0,0,0" TextWrapping="NoWrap" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Chants : le chant ouvert -->
                    <StackPanel x:Name="TeteChants" Margin="0,3,0,0">
                        <TextBlock x:Name="ChantTitre" Style="{StaticResource GrandTitre}" Text="Aucun chant choisi" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AgendaAjoutChant" Style="{StaticResource BtnPetit}" Content="+ Programme" IsEnabled="False" ToolTip="Ajouter ce chant au programme du culte" />
                            <Button x:Name="Modifier" Style="{StaticResource BtnPetit}" Content="Modifier" IsEnabled="False" Margin="8,0,0,0" />
                            <Button x:Name="Supprimer" Style="{StaticResource BtnDanger}" Content="Supprimer" IsEnabled="False" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Display : la grille -->
                    <DockPanel x:Name="TeteDisplay" Margin="0,3,0,0">
                        <TextBlock Text="Médias" Style="{StaticResource GrandTitre}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GrilleInfo" FontSize="13" Foreground="{StaticResource Brume}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,5,0,0" />
                    </DockPanel>
                    <!-- Duo : le dossier choisi -->
                    <TextBlock x:Name="TeteDuo" Style="{StaticResource GrandTitre}" Margin="0,3,0,0" Text="Duo" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- recherche de la page : Bible ou chants -->
                <Grid x:Name="Recherches" Grid.Column="1" Width="330" Margin="18,14,0,0" VerticalAlignment="Top">
                    <Border x:Name="RechercheBible" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10" Padding="12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume2}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                            <TextBlock x:Name="QIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                       Text="jn 3 16 · ps 23 · ou des mots, même mal écrits" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="Q" Grid.Column="1" Margin="8,0,0,0" FontSize="14.5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                     CaretBrush="{StaticResource Blanc}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,10" FocusVisualStyle="{x:Null}" />
                            <Button x:Name="QEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                        </Grid>
                    </Border>
                    <Border x:Name="RechercheChants" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="1" CornerRadius="10" Padding="12,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="M9,2 A7,7 0 1 1 8.99,2 Z M14,14 L19,19" Stroke="{StaticResource Brume2}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="20" Height="20" Stretch="None" />
                            <TextBlock x:Name="QcIndice" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Brume2}" IsHitTestVisible="False"
                                       Text="Chercher un chant : titre, numéro ou paroles" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="Qc" Grid.Column="1" Margin="8,0,0,0" FontSize="14.5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Blanc}"
                                     CaretBrush="{StaticResource Blanc}" SelectionBrush="{StaticResource OrVif}" VerticalContentAlignment="Center" Padding="0,10" FocusVisualStyle="{x:Null}" />
                            <Button x:Name="QcEffacer" Grid.Column="2" Style="{StaticResource BtnPlat}" Padding="8,4" Content="×" FontSize="18" Foreground="{StaticResource Brume}" Visibility="Collapsed" ToolTip="Effacer la recherche" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="Centre">
                <!-- Culte : l'écran en direct en grand, puis toutes les diapositives du culte, groupées par élément du programme -->
                <DockPanel x:Name="CentreAgenda" Visibility="Collapsed">
                    <!-- 2.0.2 : l'écran en direct est À L'ÉCRAN, dans la colonne de droite ; le centre montre le conducteur (les diapositives du culte) -->
                    <StackPanel x:Name="CulteLive" DockPanel.Dock="Top" Margin="26,20,26,16" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="CulteEnsuite" DockPanel.Dock="Right" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource Direct}" CornerRadius="10" Padding="10,3,12,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" Margin="0,1,7,0" />
                                        <TextBlock Text="En direct" FontSize="12.5" FontWeight="ExtraBold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="CulteAEcran" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Blanc}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="CulteApercu" HorizontalAlignment="Left" MaxWidth="760" Background="Black" CornerRadius="10" BorderBrush="{StaticResource Nuit3}" BorderThickness="2.5"
                                ToolTip="Ce qui est à l'écran">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <local:Rendu x:Name="CulteRendu" Width="1920" Height="1080" Transitions="False" IsHitTestVisible="False" />
                                </Viewbox>
                            </Border>
                        </Border>
                        <!-- 1.5.0 : Précédent, Suivant, Noir et Effacer sont dans la barre du bas (la télécommande) -->
                        <WrapPanel x:Name="CulteBoutons" Visibility="Collapsed">
                            <Button x:Name="CultePrec" />
                            <Button x:Name="CulteSuiv" />
                            <Button x:Name="CulteNoir" />
                            <Button x:Name="CulteRetirer" />
                            <Border x:Name="CulteRetour">
                                <TextBlock x:Name="CulteRetourTexte" Text="Retour direct : noir" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <Grid>
                        <ScrollViewer x:Name="DefilVignettes" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,18,10,24">
                            <StackPanel x:Name="Vignettes" />
                        </ScrollViewer>
                        <TextBlock x:Name="VignettesVide" Margin="26,22,26,0" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="15" LineHeight="26" Foreground="{StaticResource Brume}" IsHitTestVisible="False"
                                   Text="1. « + Ajouter au programme » à gauche : un chant, un passage, un média ou le compte à rebours d'accueil.&#x0a;2. Ou cherche en haut (Ctrl K) : « wokovu 45 », « jean 3 16 »… puis Tab.&#x0a;3. Pendant le culte : un clic sur une image la montre ; le gros bouton Suivant (ou Espace) passe à la suivante." />
                    </Grid>
                </DockPanel>

                <!-- Bible : les versets du chapitre ou les résultats de la recherche -->
                <Border x:Name="CentreBible" Style="{StaticResource Carte}" Padding="8" Margin="24,0,22,20">
                    <ScrollViewer x:Name="DefilVersets" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel x:Name="Versets" MaxWidth="1300" />
                    </ScrollViewer>
                </Border>

                <!-- Chants : les strophes du chant ouvert -->
                <ScrollViewer x:Name="DefilSections" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,12,20">
                    <WrapPanel x:Name="Sections" />
                </ScrollViewer>

                <!-- Display : la grille -->
                <ScrollViewer x:Name="DefilGrille" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,0,22,24">
                        <WrapPanel x:Name="GrilleSources" />
                        <Border x:Name="GrilleVide" BorderBrush="{StaticResource Trait2}" BorderThickness="1" CornerRadius="10" Padding="24">
                            <TextBlock TextWrapping="Wrap" FontSize="14.5" LineHeight="23" Foreground="{StaticResource Brume}" TextAlignment="Center"
                                       Text="La grille est vide. Cliquez le + d'une source à gauche pour l'ajouter ici. Ensuite, un seul clic sur une tuile l'envoie en direct sur l'écran choisi." />
                        </Border>
                        <!-- ancien éditeur de texte de Display (caché : les textes se modifient par « Modifier… ») -->
                        <StackPanel Visibility="Collapsed">
                            <TextBox x:Name="AnnonceTitre" Style="{StaticResource Champ}" />
                            <TextBlock x:Name="DisplaySourceInfo" />
                            <Button x:Name="DisplayReconnecter" Style="{StaticResource Btn}" Content="Reconnecter la source en direct" />
                            <Button x:Name="AnnonceEnregistrer" Style="{StaticResource BtnOr}" Content="Enregistrer" />
                            <Button x:Name="AnnonceAfficher" Style="{StaticResource Btn}" Content="Afficher" />
                            <Button x:Name="AnnonceAjouter" Style="{StaticResource Btn}" Content="+ Déroulé du culte" />
                            <Button x:Name="AnnonceSupprimer" Style="{StaticResource BtnRouge}" Content="Supprimer" />
                            <TextBox x:Name="AnnonceTexte" Style="{StaticResource Zone}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Duo : le dossier choisi -->
                <Grid x:Name="CentreDuo" Visibility="Collapsed" Margin="24,0,18,18">
                    <TextBlock x:Name="DuoChoisirAide" TextWrapping="Wrap" FontSize="15" LineHeight="24" Foreground="{StaticResource Brume}" Margin="2,2,4,0"
                               Text="Créez ou choisissez un dossier à gauche. Mettez-y 2 éléments (une source Display, un chant ou un verset), réglez la place et la taille de chacun, puis « + Display » pour l'avoir dans la grille de Display." />
                    <ScrollViewer x:Name="DuoEditeur" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DuoPile" Margin="0,0,8,0" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ==================== Réglages (construits en C# : ReglagesPage.cs), sur toute la largeur ==================== -->
        <Border x:Name="PanneauReglages" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{StaticResource Page}" />

        <!-- ==================== Son (construit en C# : Audio/PageSon.cs) : à la place de la colonne de gauche et du centre ==================== -->
        <Border x:Name="PanneauSon" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource Page}" />

        <!-- ==================== 2.2.0 : Montage (construit en C# : Edition/PageMontage.cs), sur toute la largeur ==================== -->
        <Border x:Name="PanneauMontage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{StaticResource Page}" />

        <!-- ==================== 2.3.0 : Miniature (construit en C# : Creation/PageMiniature.cs), sur toute la largeur ==================== -->
        <Border x:Name="PanneauMiniature" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{StaticResource Page}" />

        <!-- ==================== à droite : ce qui vient (Ensuite), puis les outils de l'écran, repliés ==================== -->
        <Border x:Name="ColonneControle" Grid.Row="1" Grid.Column="3" BorderBrush="{StaticResource Nuit3}" BorderThickness="1,0,0,0">
            <ScrollViewer x:Name="DefilColonne" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Colonne" Margin="16,20,18,20">
                    <StackPanel x:Name="ControleHaut" Visibility="Collapsed" />

                    <!-- 2.0.2, design « Conducteur » : À L'ÉCRAN (l'église, le projecteur), ENVOYER À L'ANTENNE, puis À L'ANTENNE (MyStream : YouTube, Zoom).
                         Chaque écran a sa source principale (le menu) et un bouton pour y revenir, qui n'agit que sur lui. -->
                    <StackPanel x:Name="Ecrans" Margin="0,0,0,18">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="EgliseEtat" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center"
                                       Text="Aperçu seulement" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                            <TextBlock Text="À L'ÉCRAN" FontSize="12.5" FontWeight="ExtraBold" Foreground="{StaticResource Ecran}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border x:Name="EgliseApercu" BorderBrush="{StaticResource Ecran}" BorderThickness="2.5" CornerRadius="10" Background="Black"
                                ToolTip="À L'ÉCRAN : ce qu'on voit dans l'église (l'écran de projection). Un clic dans le programme ou sur une diapositive l'y met.">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <local:Rendu x:Name="EgliseRendu" Width="1920" Height="1080" Transitions="False" Leger="True" IsHitTestVisible="False" />
                                </Viewbox>
                            </Border>
                        </Border>
                        <!-- la source principale de l'écran (son écran par défaut) et le bouton pour y revenir -->
                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="EgliseRetour" DockPanel.Dock="Right" Style="{StaticResource BtnContour}" Height="38" Padding="10,0" Margin="8,0,0,0"
                                    ToolTip="Échap : l'écran revient sur sa source principale (l'antenne ne change pas)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconeAnnuler}" Stroke="{StaticResource Ecran}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Revenir" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="Source principale" FontSize="12.5" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="EgliseChoisir" Style="{StaticResource BtnPetit}" Height="38" Padding="10,0" HorizontalContentAlignment="Stretch"
                                    ToolTip="Choisir la source principale de l'écran : noir, fond seul, ou un média (caméra, image, vidéo, fenêtre)">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Brume}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="8,1,0,0" />
                                    <TextBlock x:Name="EgliseSourceNom" Text="Noir" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="EgliseInfo" FontSize="12" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="2,7,0,0" LineHeight="17" />

                        <!-- ENVOYER À L'ANTENNE : ce qui est à l'écran part aussi sur MyStream (YouTube, Zoom) et le suit, jusqu'à « Revenir » de l'antenne -->
                        <Button x:Name="EnvoyerStream" Style="{StaticResource BtnContour}" Height="60" Padding="12,0" Margin="0,14,0,0"
                                Background="{StaticResource Antenne}" BorderBrush="{StaticResource Antenne}"
                                ToolTip="Touche S : ce qui est À L'ÉCRAN part aussi à l'antenne (YouTube, Zoom, MyStream) et la suit, jusqu'à « Revenir » de l'antenne (M)">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="EnvoyerStreamIcone" Data="M12,4 V19 M6,13 L12,19 L18,13" Stroke="{StaticResource SurAntenne}" StrokeThickness="2.4" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="EnvoyerStreamTexte" Text="ENVOYER À L'ANTENNE" FontSize="14.5" FontWeight="ExtraBold" Foreground="{StaticResource SurAntenne}" />
                                    <TextBlock x:Name="EnvoyerStreamSous" Text="YouTube · Zoom · MyStream" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SurAntenne}" Opacity="0.85" />
                                </StackPanel>
                                <Border x:Name="EnvoyerStreamTouche" BorderBrush="{StaticResource SurAntenne}" BorderThickness="1" CornerRadius="4" Padding="7,1,7,2" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="EnvoyerStreamToucheTexte" Text="S" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SurAntenne}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <DockPanel Margin="0,16,0,8">
                            <Border x:Name="StreamPastille" DockPanel.Dock="Right" CornerRadius="6" Padding="9,3,10,4" Background="{StaticResource StreamLeger}" VerticalAlignment="Center">
                                <TextBlock x:Name="StreamPastilleTexte" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Stream}" Text="YouTube · Zoom · MyStream" />
                            </Border>
                            <TextBlock Text="À L'ANTENNE" FontSize="12.5" FontWeight="ExtraBold" Foreground="{StaticResource RougeTexte}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border x:Name="StreamApercu" BorderBrush="{StaticResource Direct}" BorderThickness="2.5" CornerRadius="10" Background="Black"
                                ToolTip="À L'ANTENNE : ce qui part sur YouTube, Zoom et MyStream">
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <local:Rendu x:Name="StreamRendu" Width="1920" Height="1080" Transitions="False" Leger="True" IsHitTestVisible="False" />
                                </Viewbox>
                            </Border>
                        </Border>
                        <DockPanel Margin="0,10,0,0">
                            <Button x:Name="StreamRetour" DockPanel.Dock="Right" Style="{StaticResource BtnContour}" Height="38" Padding="10,0" Margin="8,0,0,0"
                                    ToolTip="Touche M : l'antenne revient sur sa source principale et ne suit plus l'écran (l'écran de l'église ne change pas)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconeAnnuler}" Stroke="{StaticResource RougeTexte}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Revenir" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock DockPanel.Dock="Left" Text="Source principale" FontSize="12.5" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="StreamChoisir" Style="{StaticResource BtnPetit}" Height="38" Padding="10,0" HorizontalContentAlignment="Stretch"
                                    ToolTip="Choisir la source principale de l'antenne (caméra, MyCam, image, vidéo, fenêtre)">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Brume}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="8,1,0,0" />
                                    <TextBlock x:Name="StreamSourceNom" Text="Aucune" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="StreamInfo" FontSize="12" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="2,7,0,0" LineHeight="17"
                                   Text="Pas de source principale : l'antenne montre comme l'écran." />
                    </StackPanel>

                    <!-- 2.0.2 : plus de zone « Ensuite » séparée (ce qui est choisi va À L'ÉCRAN) ; Suivant dit ce qui vient, en bas -->
                    <DockPanel Margin="0,0,0,12" Visibility="Collapsed">
                        <Button x:Name="Decouper" DockPanel.Dock="Right" Style="{StaticResource BtnPetit}" Content="Découper" FontSize="12" Padding="9,4" IsEnabled="False" VerticalAlignment="Center"
                                ToolTip="Couper la diapositive qui vient en plusieurs (Entrée devant une ligne)" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource Ensuite}" CornerRadius="10" Padding="10,3,11,4" VerticalAlignment="Center">
                                <TextBlock Text="Ensuite" FontSize="12.5" FontWeight="ExtraBold" Foreground="{StaticResource SurEnsuite}" />
                            </Border>
                            <TextBlock x:Name="SuivantLab" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Blanc}" TextTrimming="CharacterEllipsis" MaxWidth="150"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Text="—" />
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="SuivantApercu" Visibility="Collapsed" BorderBrush="{StaticResource Ensuite}" BorderThickness="2.5" CornerRadius="10" Background="{StaticResource Damier}" ToolTip="La diapositive qui vient avec Suivant">
                        <Border CornerRadius="10" ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <local:Rendu x:Name="SuivantRendu" Width="1920" Height="1080" Transitions="False" Leger="True" IsHitTestVisible="False" />
                            </Viewbox>
                        </Border>
                    </Border>
                    <TextBlock x:Name="SuivantTexte" Visibility="Collapsed" FontSize="12.5" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="2,6,0,0" />

                    <Button x:Name="Afficher" Style="{StaticResource BtnContour}" Height="48" Padding="0" Margin="0,14,0,0" ToolTip="Entrée : montrer ce qui est choisi">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Montrer la sélection" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Touche}" Margin="10,0,0,0">
                                <TextBlock Text="Entrée" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brume}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- outils de l'écran (1.5.0) : un clic ouvre la ligne, un autre la referme -->
                    <StackPanel Margin="0,18,0,0">
                        <ToggleButton x:Name="TiroirStyle" Style="{StaticResource TiroirTete}" Tag="{StaticResource IconePalette}" ToolTip="Le fond des paroles et la présentation (plein écran ou bandeau)">
                            <DockPanel>
                                <TextBlock x:Name="TiroirStyleValeur" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Text="Aube" />
                                <TextBlock Text="Style de l'écran" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ToggleButton>
                        <StackPanel x:Name="CorpsStyle" Visibility="Collapsed" Margin="2,2,2,14">
                            <WrapPanel x:Name="Fonds" />
                            <DockPanel Margin="0,8,0,0">
                                <ComboBox x:Name="Presentation" DockPanel.Dock="Right" Width="150" ToolTip="Présentation">
                                    <ComboBoxItem Tag="plein" Content="Plein écran" />
                                    <ComboBoxItem Tag="bandeau" Content="En bandeau" />
                                </ComboBox>
                                <TextBlock Text="Présentation" FontSize="14" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <ToggleButton x:Name="TiroirTaille" Style="{StaticResource TiroirTete}" Tag="{StaticResource IconeTexte}" ToolTip="La taille des paroles à l'écran">
                            <DockPanel>
                                <TextBlock x:Name="TiroirTailleValeur" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Text="100 %" />
                                <TextBlock Text="Taille du texte" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ToggleButton>
                        <StackPanel x:Name="CorpsTaille" Visibility="Collapsed" Margin="2,2,2,14">
                            <Slider x:Name="Taille" Minimum="0.6" Maximum="1.2" SmallChange="0.05" LargeChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="1" />
                        </StackPanel>

                        <ToggleButton x:Name="TiroirCoin" Style="{StaticResource TiroirTete}" Tag="{StaticResource IconeCoin}" ToolTip="Touche P : garder ce qui est à l'écran dans un coin, et montrer autre chose à côté (Duo)">
                            <DockPanel>
                                <TextBlock x:Name="DuoEtat" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Text="touche P" />
                                <TextBlock Text="Garder dans un coin" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ToggleButton>
                        <StackPanel x:Name="CorpsCoin" Visibility="Collapsed" Margin="2,2,2,14">
                            <TextBlock x:Name="DuoAide" Text="Montre un premier contenu, garde-le dans un coin (touche P), puis montre le second." FontSize="13" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Border x:Name="DuoBoite" Background="{StaticResource Nuit2}" CornerRadius="10" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Dans le coin" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="DuoLibelle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Blanc}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Button x:Name="DuoEpingler" Style="{StaticResource BtnContour}" Content="Garder dans un coin" Height="44" Padding="0" ToolTip="Touche P : ce qui est à l'écran part dans le coin, l'écran se libère pour autre chose" />
                            <Button x:Name="DuoRetirer" Style="{StaticResource Btn}" Content="Enlever le coin" Height="44" Padding="0" Margin="0,8,0,0" IsEnabled="False" Visibility="Collapsed" ToolTip="Touche P : enlève seulement ce qui est dans le coin" />
                            <DockPanel Margin="0,12,0,0">
                                <ComboBox x:Name="DuoPlace" DockPanel.Dock="Right" Width="150" MinHeight="40" ToolTip="Place du contenu gardé">
                                    <ComboBoxItem Tag="hd" Content="Haut droite" />
                                    <ComboBoxItem Tag="hg" Content="Haut gauche" />
                                    <ComboBoxItem Tag="bd" Content="Bas droite" />
                                    <ComboBoxItem Tag="bg" Content="Bas gauche" />
                                    <ComboBoxItem Tag="cote" Content="Côte à côte" />
                                </ComboBox>
                                <TextBlock Text="Place" FontSize="14" Foreground="{StaticResource Brume}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="DuoTailleLab" Text="Taille du coin : 35 %" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Encre2}" Margin="0,12,0,4" />
                            <Slider x:Name="DuoTaille" Minimum="20" Maximum="50" SmallChange="5" LargeChange="5" TickFrequency="5" IsSnapToTickEnabled="True" Value="35" />
                        </StackPanel>

                        <ToggleButton x:Name="TiroirRepos" Style="{StaticResource TiroirTete}" Tag="{StaticResource IconeLune}" ToolTip="Ce qui revient quand on efface (Échap) : noir, le fond seul, ou un écran du programme (logo…)">
                            <DockPanel>
                                <TextBlock x:Name="TiroirReposValeur" DockPanel.Dock="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brume}" VerticalAlignment="Center" Text="Noir"
                                           TextTrimming="CharacterEllipsis" MaxWidth="96" />
                                <TextBlock Text="Écran de repos" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </ToggleButton>
                        <Border x:Name="CarteDefaut" Visibility="Collapsed" Margin="2,2,2,14">
                            <StackPanel>
                                <TextBlock Text="Quand tu effaces (Échap), l'écran revient tout de suite ici." FontSize="12.5" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel x:Name="DefautChoix" />
                                <TextBlock Text="Un logo ou une image ? « + Ajouter au programme » › Écran principal." FontSize="11.5" Foreground="{StaticResource Brume}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="TiroirAide" Style="{StaticResource TiroirTete}" Tag="{StaticResource IconeClavier}" ToolTip="Les touches du clavier">
                            <TextBlock Text="Raccourcis clavier" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </ToggleButton>
                        <StackPanel x:Name="CorpsAide" Visibility="Collapsed" Margin="2,2,2,14">
                            <WrapPanel x:Name="Aide" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== en bas : la télécommande (ce qui est à l'écran, Précédent, Suivant, Noir, Effacer) ==================== -->
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Background="{StaticResource Encre}" BorderBrush="{StaticResource Nuit3}" BorderThickness="0,1,0,0" Padding="18,0,20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid>
                        <Border x:Name="Apercu" Width="128" Height="72" BorderBrush="{StaticResource Nuit3}" BorderThickness="2" CornerRadius="10" Background="{StaticResource Damier}"
                                ToolTip="Ce qui est à l'écran. Double-clic : découper cette diapositive" Cursor="Hand">
                            <Viewbox Stretch="Uniform">
                                <local:Rendu x:Name="ApercuRendu" Width="1920" Height="1080" Transitions="False" Leger="True" />
                            </Viewbox>
                        </Border>
                        <Border x:Name="Pastille" Visibility="Collapsed">
                            <TextBlock x:Name="PastilleTexte" Text="Écran fermé" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="14,0,8,0" VerticalAlignment="Center" MaxWidth="250">
                        <TextBlock x:Name="BarreTitre" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource Blanc}" TextTrimming="CharacterEllipsis" Text="Rien à l'écran" />
                        <TextBlock x:Name="BarreSous" FontSize="12.5" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <StackPanel x:Name="BarreProgres" Orientation="Horizontal" Margin="0,7,0,0" />
                        <TextBlock x:Name="EcranInfo" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brume}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Prec" Style="{StaticResource BtnRond}" ToolTip="Précédent (flèche gauche)">
                        <Path Data="M9,0 L0,7 L9,14 Z" Fill="{StaticResource Blanc}" Margin="0,0,3,0" />
                    </Button>
                    <Button x:Name="Suiv" Style="{StaticResource BtnSuivant}" Margin="14,0,0,0" ToolTip="Suivant (flèche droite ou Espace)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SUIVANT" VerticalAlignment="Center" />
                            <Path Data="M0,0 L10,7 L0,14 Z" Fill="{StaticResource SurPrimaire}" VerticalAlignment="Center" Margin="12,1,0,0" />
                            <!-- 2.0.2 : ce qui vient avec Suivant (« Jean 3:17 ») -->
                            <TextBlock x:Name="SuivProchain" FontSize="14" FontWeight="SemiBold" Opacity="0.72" VerticalAlignment="Center" Margin="14,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                            <Border BorderBrush="{StaticResource Brume2}" BorderThickness="1" CornerRadius="6" Padding="7,1,7,2" Margin="16,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Espace" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource SurPrimaire}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="NoirBtn" Style="{StaticResource Btn}" Height="52" Padding="16,0" FontWeight="Bold" ToolTip="Écran noir (touche B) : le texte est caché sans être perdu">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="15" Height="15" CornerRadius="3" Background="#111111" BorderBrush="{StaticResource Trait2}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="Noir" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Touche}" Margin="10,0,0,0">
                                <TextBlock Text="B" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brume}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Effacer" Style="{StaticResource Btn}" Height="52" Padding="16,0" Margin="10,0,0,0" FontWeight="Bold" Foreground="{StaticResource RougeTexte}" ToolTip="Échap">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource RougeTexte}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="Effacer" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Touche}" Margin="10,0,0,0">
                                <TextBlock Text="Échap" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brume}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- message court, au-dessus de la télécommande -->
        <Border x:Name="ToastBoite" Grid.ColumnSpan="4" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110" Background="{StaticResource Blanc}" BorderThickness="0"
                CornerRadius="10" Padding="18,11" MaxWidth="900" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastTexte" TextWrapping="Wrap" Foreground="{StaticResource Page}" FontSize="14" />
        </Border>
    </Grid>
</Window>
