<Project Sdk="Microsoft.NET.Sdk">
  <!-- MyVerse 4.0 : logiciel Windows natif (WPF). Le cœur (Bible, chants, téléphone, OBS) est dans MyVerse.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyVerse.Ui</RootNamespace>
    <AssemblyName>SiloeStream</AssemblyName>
    <ApplicationIcon>myverse.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.1</Version>
    <FileVersion>1.9.1.0</FileVersion>
    <Product>Siloé Stream</Product>
    <AssemblyTitle>Siloé Stream</AssemblyTitle>
    <Company>MEPC Montréal</Company>
    <Copyright>MEPC Montréal</Copyright>
    <Description>Siloé Stream 1.3.0 : projection d église (Bible, chants, Display, Duo, MyCam) et son simple (page Son)</Description>
    <NeutralLanguage>fr</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <NoWarn>$(NoWarn);CA1416;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyVerse.Core\MyVerse.Core.csproj" />
  </ItemGroup>

  <!-- 1.6.0 : « Connecter le compte YouTube » : l'identifiant Google de l'église (programme installé), donné par les secrets
       YOUTUBE_CLIENT_ID et YOUTUBE_CLIENT_SECRET du dépôt au moment de la compilation. Sans eux, la clé de stream marche quand même. -->
  <ItemGroup>
    <AssemblyMetadata Include="YouTubeClientId" Value="$(YOUTUBE_CLIENT_ID)" />
    <AssemblyMetadata Include="YouTubeClientSecret" Value="$(YOUTUBE_CLIENT_SECRET)" />
  </ItemGroup>

  <ItemGroup>
    <!-- code QR du jumelage, lecture des recueils en PDF -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- capture ASIO (Focusrite, Behringer, PreSonus…), comme le plugin ASIO d OBS -->
    <PackageReference Include="NAudio.Asio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <!-- 2.2.0 : la recherche vocale (chant ou Bible) reconnue sur le PC, sans Internet : whisper.cpp (licence MIT) -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Ressources\**\*" />
    <Content Include="Ressources\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Polices\*.ttf" />
    <Resource Include="myverse.ico" />
    <Resource Include="logo-icone.png" />
    <Resource Include="logo-complet.png" />
    <SplashScreen Include="demarrage.png" />
  </ItemGroup>
</Project>
